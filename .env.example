# ─── LLM Keys (required, at least 2) ──────────────────────────────────────────
# Get keys at https://console.groq.com/keys
LLM_API_KEYS=your_groq_key_1,your_groq_key_2

# ─── LLM Model ────────────────────────────────────────────────────────────────
# Available: groq/openai/gpt-oss-20b (fastest), groq/openai/gpt-oss-120b (most capable)
LLM_MODEL=groq/openai/gpt-oss-20b

# ─── Default system prompt ────────────────────────────────────────────────────
DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.

# ─── Storage ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:////data/app.db
CACHE_DIR=/data/llm_cache

# ─── CORS (comma-separated frontend origins) ──────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Feature flags ────────────────────────────────────────────────────────────
# Set to "true" to enable the X-Simulate-Failure test hook
ENABLE_FAILURE_SIMULATION=true

# ─── LiteLLM internal (prevents startup network fetch of model cost map) ──────
# Keeps the container startup fast; set to 1 always.
LITELLM_LOCAL_MODEL_COST_MAP=1

# ─── Frontend (build-time, used by Docker Compose) ───────────────────────────
VITE_API_BASE_URL=http://localhost:8000
